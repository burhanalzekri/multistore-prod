# Never commit real values. Use Neon pooled URL at runtime and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/multistore?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/multistore?sslmode=require"

# Auth.js v5
AUTH_SECRET="replace-with-a-random-secret-at-least-32-bytes"
AUTH_URL="http://localhost:3000"
AUTH_RATE_LIMIT_SECRET="use-a-separate-random-secret-at-least-32-bytes"
EMAIL_SERVER=""
EMAIL_FROM="MultiStore <no-reply@example.com>"

# Multi-tenant routing; server-only and overwritten host headers are required.
PLATFORM_ROOT_DOMAIN="multistore.store"

# Cloudinary (server-side secret must never use NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
MULTISTORE_MEDIA_DIR="./var/uploads"

# Public URL and optional monitoring
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional demo seed: local/test only; never enable in production.
# ALLOW_DEMO_SEED=true
# DEMO_OWNER_EMAIL="owner@example.test"
# DEMO_OWNER_PASSWORD="use-a-new-random-password-of-at-least-12-characters"

# Optional email/SMS provider credentials will be added with their feature phase.
