{
  "name": "multistore",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx prisma generate --schema prisma/schema.prisma",
    "db:validate": "bunx prisma validate --schema prisma/schema.prisma",
    "db:migrate": "bunx prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "bunx prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "bun --bun prisma/seed.ts",
    "analyze": "ANALYZE=true bun --bun next build",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.30.0",
    "@tanstack/react-query": "^5.90.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.16",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "15.5.27",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.3"
  }
}
