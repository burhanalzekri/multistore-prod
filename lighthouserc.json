{
  "ci": {
    "collect": {
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 1, "disabled": false }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.98 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 800 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }],
        "speed-index": ["error", { "maxNumericValue": 1500 }],
        "server-response-time": ["error", { "maxNumericValue": 100 }],
        "errors-in-console": ["error", { "minScore": 1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 100000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 500000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
